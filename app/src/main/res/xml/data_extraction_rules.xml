<?xml version="1.0" encoding="utf-8"?>
<!-- Auth tokens and the server connection must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="supabase_session_secure.xml"/>
        <exclude domain="sharedpref" path="supabase_connection.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="supabase_session_secure.xml"/>
        <exclude domain="sharedpref" path="supabase_connection.xml"/>
    </device-transfer>
</data-extraction-rules>
